# =============================================================================
# نمونه Secretهای موردنیاز برای توسعهٔ محلی.
# این فایل را به .dev.vars کپی کنید؛ .dev.vars را commit نکنید.
# در production هر مقدار حساس را با `npx wrangler secret put NAME` ثبت کنید.
# =============================================================================
MASTER_BOT_TOKEN=123456789:AAExampleTokenFromBotFather
MASTER_WEBHOOK_SECRET=replace-with-random-telegram-safe-secret
WEBHOOK_BASE_URL=https://app-telegram-cc.example.workers.dev

# -----------------------------------------------------------------------------
# دیتابیس اختصاصی App-Telegram-CC
# Project name: db_tel_cc
# Project ref : hovjhysmghcuxbknpvmr
# توجه: این پروژه نباید به دیتابیس ai-panel یا هیچ پروژهٔ دیگری متصل شود.
# SUPABASE_URL عمومی است؛ ولی SUPABASE_SERVICE_ROLE_KEY یک Secret بسیار حساس است.
# -----------------------------------------------------------------------------
SUPABASE_URL=https://hovjhysmghcuxbknpvmr.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-db_tel_cc-service-role-key

# دقیقاً 32 بایت تصادفی به‌شکل Base64؛ برای AES-GCM توکن‌های BotFather.
# نمونهٔ ساخت: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=replace-with-base64-32-byte-key

# Pepper سراسری برای HMAC پین مدیریت؛ مقدار قوی و تصادفی بسازید.
# نمونهٔ ساخت: openssl rand -hex 32
PIN_PEPPER=replace-with-long-random-pepper

# کلید محافظ endpointهای راه‌اندازی قدیمی/مدیریتی، در صورت استفاده.
ADMIN_SETUP_SECRET=replace-with-long-random-setup-secret
