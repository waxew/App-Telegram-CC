<?xml version="1.0" encoding="utf-8"?>
<!--
=============================================================================
AndroidManifest.xml
مجوزها و Activity ورودی برنامه را تعریف می‌کند.
=============================================================================
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- اپ برای ارتباط HTTPS با Cloudflare Worker به اینترنت نیاز دارد. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:label="تلگرام CC"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar"
        android:usesCleartextTraffic="false">

        <!-- Activity اصلی و تنها نقطهٔ ورود نسخهٔ فعلی برنامه. -->
        <activity
            android:name=".MainActivity"
            android:exported="true">

            <!-- این Intent Filter باعث نمایش اپ در Launcher می‌شود. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
